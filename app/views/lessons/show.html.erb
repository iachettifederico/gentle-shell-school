<% content_for :title, "#{lesson.title} · #{t('site.title')}" %>
<% content_for :description, lesson.description %>
<% content_for :og_title, "#{lesson.title} · #{t('site.title')}" %>
<% content_for :og_description, lesson.description %>

<section class="mx-auto max-w-[44rem]" data-controller="progress" data-progress-lesson-slug-value="<%= lesson.slug %>" data-progress-completed-label-value="<%= t("home.completed") %>" data-progress-copy-label-value="<%= t("home.copy") %>" data-progress-copied-label-value="<%= t("progress.copied") %>" data-progress-not-completed-label-value="<%= t("progress.not_completed") %>" data-progress-mark-incomplete-label-value="<%= t("progress.mark_incomplete") %>" data-progress-mark-complete-label-value="<%= t("progress.mark_complete") %>" data-progress-verified-label-value="<%= t("progress.verified") %>" data-progress-independently-verified-label-value="<%= t("progress.independently_verified") %>">
  <header>
    <% if lesson.module_name.present? %>
      <p data-lesson-module class="eyebrow"><%= lesson.module_name %></p>
    <% end %>
    <p class="mt-4 chip w-fit"><%= t("lesson.label", number: format("%02d", lesson.order)) %></p>
    <h1 class="mt-5 text-4xl leading-[1.02] font-extrabold tracking-[-0.05em] text-fg sm:text-6xl"><%= lesson.title %></h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-pretty text-fg-muted"><%= lesson.description %></p>
  </header>

  <section aria-label="<%= t("lesson.label", number: format("%02d", lesson.order)) %>" class="card mt-10 p-5 sm:p-6">
    <p data-progress-target="enrollmentPrompt" class="text-sm leading-6 text-fg-muted"><%= t("lesson.track_html", link: link_to(t("lesson.enroll_home"), locale_context.root_path, class: "link")) %></p>
    <div data-progress-target="lessonProgress" hidden class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p data-progress-target="status" aria-live="polite" class="text-sm font-semibold text-fg"></p>
      <button type="button" data-action="progress#toggleCompletion" data-progress-target="completionButton" class="btn btn-primary btn-sm shrink-0 self-start sm:self-auto"></button>
    </div>
  </section>

  <div data-lesson-prompt class="mt-8">
    <%= render layout: "shared/prompt_card", locals: { heading: t("lesson.start_prompt"), prompt: prompt, template: template, hint: t("lesson.start_hint"), copy_label: t("home.copy") } do %>
      <a href="<%= locale_context.lesson_path("install-gentle-shell") %>" class="link text-sm"><%= t("home.need_install") %></a>
    <% end %>
  </div>

  <article class="prose prose-lg prose-shell mt-14 max-w-none">
    <%= sanitize body_html %>
  </article>

  <% if lab %>
    <section data-lesson-lab aria-labelledby="lab-heading" class="card mt-14 p-5 sm:p-7">
      <h2 id="lab-heading" class="eyebrow"><%= t("lesson.lab") %></h2>
      <h3 class="mt-3 text-2xl font-bold tracking-[-0.03em] text-fg"><%= lab.title %></h3>
      <div class="prose prose-shell mt-4 max-w-none">
        <%= sanitize lab_brief_html %>
      </div>
      <p class="mt-6 text-sm leading-6 text-fg-muted"><%= t("lesson.lab_note") %></p>
    </section>
  <% end %>

  <p class="mt-10 text-sm text-fg-muted"><a href="https://github.com/<%= Rails.configuration.x.course.feedback_repository %>/issues/new?template=course-feedback.yml&lesson=<%= lesson.slug %>&title=%5BCourse+feedback%5D+<%= lesson.slug %>%3A+" class="link"><%= t("lesson.report") %></a></p>

  <nav data-lesson-navigation class="mt-12 grid gap-4 border-t border-line pt-8 sm:grid-cols-2">
    <% if previous_lesson %>
      <%= link_to locale_context.lesson_path(previous_lesson.slug), class: "card group min-h-28 p-5 transition hover:bg-raised" do %>
        <span class="flex items-center gap-2 font-mono text-xs font-medium tracking-[0.12em] text-fg-subtle uppercase"><svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M12.78 4.22a.75.75 0 0 1 0 1.06L8.06 10l4.72 4.72a.75.75 0 0 1-1.06 1.06l-5.25-5.25a.75.75 0 0 1 0-1.06l5.25-5.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" /></svg><%= t("lesson.previous") %></span>
        <span class="mt-3 block text-lg font-bold tracking-[-0.02em] text-fg transition-colors group-hover:text-brand-300"><%= previous_lesson.title %></span>
      <% end %>
    <% end %>
    <% if next_lesson %>
      <%= link_to locale_context.lesson_path(next_lesson.slug), class: "card group min-h-28 p-5 transition hover:bg-raised sm:text-right #{'sm:col-start-2' unless previous_lesson}" do %>
        <span class="flex items-center gap-2 font-mono text-xs font-medium tracking-[0.12em] text-fg-subtle uppercase sm:justify-end"><%= t("lesson.next") %><svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M7.22 4.22a.75.75 0 0 1 1.06 0l5.25 5.25a.75.75 0 0 1 0 1.06l-5.25 5.25a.75.75 0 1 1-1.06-1.06L11.94 10 7.22 5.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg></span>
        <span class="mt-3 block text-lg font-bold tracking-[-0.02em] text-fg transition-colors group-hover:text-brand-300"><%= next_lesson.title %></span>
      <% end %>
    <% end %>
  </nav>
</section>
