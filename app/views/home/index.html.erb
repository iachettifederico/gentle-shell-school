<section class="space-y-6">
  <p class="text-sm font-mono uppercase tracking-[0.15em] text-emerald-700">Free · self-paced · agent-taught</p>
  <h1 class="text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">Learn gentle-shell</h1>
  <p class="max-w-2xl text-lg leading-8 text-slate-600">
    Every lesson is written for two readers: you, here on the website, and your agent, through the course API.
    Your agent teaches each lesson, quizzes you, and checks your real setup.
  </p>
</section>

<section class="mt-12" data-controller="progress">
  <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-6">
    <button type="button" data-action="progress#enroll" data-progress-target="enrollButton" class="rounded-lg bg-emerald-700 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800">
      Enroll
    </button>
    <div data-progress-target="student" hidden>
      <p class="text-sm text-slate-700">Your student ID: <span data-progress-target="studentId" class="font-mono font-semibold"></span></p>
      <p class="mt-2 text-sm text-slate-600">Give this ID to your agent. Instructions: <a data-progress-target="instructionsUrl" class="font-mono text-emerald-700 underline hover:text-emerald-900"></a></p>
      <button type="button" data-action="progress#forget" data-progress-target="forgetButton" class="mt-3 text-sm font-medium text-slate-600 underline hover:text-slate-900">
        Forget this ID
      </button>
    </div>
  </div>

  <h2 class="mt-12 text-sm font-mono uppercase tracking-[0.15em] text-slate-500">Lessons</h2>
  <ol class="mt-4 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
    <% lessons.each do |lesson| %>
      <li data-progress-target="lesson" data-lesson-slug="<%= lesson.slug %>" class="px-6 py-4">
        <a href="<%= lesson_path(lesson.slug) %>" data-lesson class="text-lg font-medium text-slate-900 hover:text-emerald-700">
          <%= lesson.title %>
        </a>
        <span data-progress-target="completion" data-lesson-slug="<%= lesson.slug %>" hidden aria-label="Completed" class="ml-2 text-emerald-700">✓</span>
        <p class="mt-1 text-sm text-slate-600"><%= lesson.description %></p>
      </li>
    <% end %>
  </ol>
</section>
