<% content_for :description, t("site.description") %>
<% completed_placeholder = [ "%", "{completed}" ].join %><% total_placeholder = [ "%", "{total}" ].join %><% title_placeholder = [ "%", "{title}" ].join %>
<div data-controller="progress" data-progress-copy-label-value="<%= t("home.copy") %>" data-progress-copied-label-value="<%= t("progress.copied") %>" data-progress-not-completed-label-value="<%= t("progress.not_completed") %>" data-progress-mark-incomplete-label-value="<%= t("progress.mark_incomplete") %>" data-progress-mark-complete-label-value="<%= t("progress.mark_complete") %>" data-progress-verified-label-value="<%= t("progress.verified") %>" data-progress-independently-verified-label-value="<%= t("progress.independently_verified") %>" data-progress-all-complete-label-value="<%= t("progress.all_complete") %>" data-progress-complete-count-label-value="<%= t("progress.complete_count", completed: completed_placeholder, total: total_placeholder) %>" data-progress-continue-label-value="<%= t("progress.continue", title: title_placeholder) %>" data-progress-module-count-label-value="<%= t("progress.module_count", completed: completed_placeholder, total: total_placeholder) %>">
  <section data-hero class="relative isolate grid items-start gap-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-14">
    <div aria-hidden="true" class="pointer-events-none absolute -top-32 -left-32 -z-10 h-96 w-[42rem] max-w-full rounded-full bg-[radial-gradient(circle_at_center,rgb(255_118_195_/_0.18),transparent_68%)] blur-2xl"></div>
    <div class="min-w-0">
      <p class="eyebrow"><%= t("home.badge") %></p>
      <h1 class="mt-6 text-5xl leading-[0.95] font-extrabold tracking-[-0.055em] text-fg sm:text-7xl">Gentle <span class="text-brand-500">Shell</span><br>School</h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-pretty text-fg-muted"><%= t("home.intro") %></p>
      <p class="mt-8 max-w-xl text-lg leading-8 font-semibold text-pretty text-fg"><%= t("home.cta_lead") %></p>
      <p class="mt-2 max-w-xl text-base leading-7 text-pretty text-fg-muted"><%= t("home.cta_note") %></p>
    </div>
    <div class="grid min-w-0 gap-6">
    <section aria-labelledby="course-heading" class="card p-5 sm:p-7">
      <div class="flex flex-col gap-5">
        <div class="flex items-start gap-4">
          <span aria-hidden="true" class="grid size-10 shrink-0 place-items-center rounded-xl bg-brand-950 text-brand-400 ring-1 ring-brand-500/30">
            <svg viewBox="0 0 20 20" fill="currentColor" class="size-5"><path d="M5 2.75A1.75 1.75 0 0 1 6.75 1h6.5A1.75 1.75 0 0 1 15 2.75v15.5a.75.75 0 0 1-1.2.6L10 16.06l-3.8 2.79a.75.75 0 0 1-1.2-.6V2.75Z" /></svg>
          </span>
          <div>
            <h2 id="course-heading" class="eyebrow"><%= t("home.course") %></h2>
            <p class="mt-1.5 text-base leading-7 text-fg-muted"><%= t("home.keep_place") %></p>
          </div>
        </div>
        <button type="button" data-action="progress#enroll" data-progress-target="enrollButton" class="btn btn-primary self-start"><%= t("home.enroll") %></button>
      </div>
      <div data-progress-target="student" hidden class="mt-6 grid gap-6 border-t border-line pt-6">
        <div>
          <p data-progress-target="summary" aria-live="polite" class="text-xl font-bold tracking-[-0.02em] text-fg"></p>
          <p data-progress-target="continue" class="mt-3" hidden><a href="<%= locale_context.lesson_path("welcome") %>" class="btn btn-secondary btn-sm"></a></p>
        </div>
        <div class="space-y-3 text-sm leading-6 text-fg-muted">
          <p><%= t("home.student_id") %> <span data-progress-target="studentId" class="chip text-fg"></span></p>
          <button type="button" data-action="progress#forget" data-progress-target="forgetButton" class="btn-ghost min-h-6 text-sm font-medium underline"><%= t("home.forget") %></button>
        </div>
      </div>
      <p class="mt-5 border-t border-line pt-4 text-sm"><a href="<%= locale_context.lesson_path("install-gentle-shell") %>" class="link"><%= t("home.need_install") %></a></p>
    </section>
      <div data-progress-target="enrolledOnly" hidden>
        <%= render layout: "shared/prompt_card", locals: { id: "start", heading: t("home.start"), prompt: start_prompt, template: start_template, hint: t("home.start_hint"), copy_label: t("home.copy") } do %>
          <a href="<%= locale_context.lesson_path("welcome") %>" class="link text-sm"><%= t("home.read_first") %></a>
        <% end %>
      </div>
    </div>
  </section>

  <section id="lessons" aria-labelledby="syllabus-heading" class="mt-20 scroll-mt-24">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 id="syllabus-heading" class="text-3xl font-extrabold tracking-[-0.04em] text-fg"><%= t("home.syllabus") %></h2>
      <p data-lesson-count class="chip"><%= t("home.lesson_count", count: lesson_groups.values.sum(&:size)) %></p>
    </div>
    <div class="mt-8 grid gap-6">
      <% lesson_groups.each_with_index do |(module_name, lessons), index| %>
        <section aria-labelledby="module-<%= index + 1 %>" class="card overflow-hidden">
          <div class="flex items-center justify-between gap-4 px-5 py-4 sm:px-6">
            <div class="flex min-w-0 items-center gap-3">
              <span aria-hidden="true" class="grid size-8 shrink-0 place-items-center rounded-lg bg-brand-950 font-mono text-xs font-semibold text-brand-300 ring-1 ring-brand-500/25"><%= format("%02d", index + 1) %></span>
              <h3 id="module-<%= index + 1 %>" data-module-name="<%= module_name %>" class="text-base font-bold text-fg"><%= module_name %></h3>
            </div>
            <span hidden data-module-name="<%= module_name %>" data-module-total="<%= lessons.size %>" data-progress-module-count class="chip shrink-0"><%= t("home.module_zero", count: lessons.size) %></span>
          </div>
          <ol class="border-t border-line">
            <% lessons.each do |lesson| %>
              <li data-progress-target="lesson" data-lesson-slug="<%= lesson.slug %>" data-module-name="<%= module_name %>" class="group relative flex items-start gap-4 border-line px-5 py-4 transition-colors not-first:border-t hover:bg-raised sm:px-6">
                <span aria-hidden="true" class="w-6 shrink-0 pt-0.5 font-mono text-xs leading-6 text-fg-muted"><%= format("%02d", lesson.order) %></span>
                <div class="min-w-0 flex-1">
                  <a href="<%= locale_context.lesson_path(lesson.slug) %>" data-lesson class="font-semibold text-fg transition-colors group-hover:text-brand-300 after:absolute after:inset-0 focus-visible:outline-none focus-visible:after:ring-2 focus-visible:after:ring-brand-300 focus-visible:after:ring-inset"><%= lesson.title %></a>
                  <p class="mt-1 text-sm leading-6 text-pretty text-fg-muted"><%= lesson.description %></p>
                </div>
                <span data-progress-target="completion" data-lesson-slug="<%= lesson.slug %>" data-completed-label="<%= t("home.completed") %>" hidden role="img" aria-label="<%= t("home.completed") %>" class="badge-success mt-0.5 shrink-0">✓</span>
                <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 size-5 shrink-0 text-fg-muted transition group-hover:translate-x-0.5 group-hover:text-brand-300"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.17 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd" /></svg>
              </li>
            <% end %>
          </ol>
        </section>
      <% end %>
    </div>
  </section>
</div>
