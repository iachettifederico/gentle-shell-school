<% content_for :description, t("site.description") %>
<section class="mx-auto max-w-3xl py-10 text-center sm:py-18"><p class="inline-flex rounded-full border border-shell-accent/25 bg-shell-accent-subtle px-3 py-1 font-mono text-xs text-shell-accent"><%= t("home.badge") %></p><h1 class="mt-7 text-5xl font-extrabold tracking-[-0.065em] text-shell-text sm:text-7xl">Gentle <span class="text-shell-accent">Shell</span><br>School</h1><p class="mx-auto mt-6 max-w-2xl text-base leading-7 text-shell-muted sm:text-lg sm:leading-8"><%= t("home.intro") %></p><div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row"><a href="#start" class="rounded-full bg-shell-accent px-5 py-3 text-sm font-semibold text-white"><%= t("home.start") %></a><a href="/llms.txt" class="rounded-full border border-shell-border bg-shell-card px-5 py-3 font-mono text-sm font-medium text-shell-text">llms.txt</a></div></section>
<% completed_placeholder = [ "%", "{completed}" ].join %><% total_placeholder = [ "%", "{total}" ].join %><% title_placeholder = [ "%", "{title}" ].join %>
<section id="lessons" class="mt-8 scroll-mt-6" data-controller="progress" data-progress-copy-label-value="<%= t("home.copy") %>" data-progress-copied-label-value="<%= t("progress.copied") %>" data-progress-not-completed-label-value="<%= t("progress.not_completed") %>" data-progress-mark-incomplete-label-value="<%= t("progress.mark_incomplete") %>" data-progress-mark-complete-label-value="<%= t("progress.mark_complete") %>" data-progress-verified-label-value="<%= t("progress.verified") %>" data-progress-independently-verified-label-value="<%= t("progress.independently_verified") %>" data-progress-all-complete-label-value="<%= t("progress.all_complete") %>" data-progress-complete-count-label-value="<%= t("progress.complete_count", completed: completed_placeholder, total: total_placeholder) %>" data-progress-continue-label-value="<%= t("progress.continue", title: title_placeholder) %>" data-progress-module-count-label-value="<%= t("progress.module_count", completed: completed_placeholder, total: total_placeholder) %>">
  <% prompt = t("home.start_prompt", origin: request.base_url) %><div id="start" class="scroll-mt-6 rounded-2xl border border-shell-accent/40 bg-shell-code p-5 sm:p-7"><h2 class="text-lg font-semibold text-shell-text"><%= t("home.start") %></h2><p class="mt-2 font-mono text-sm leading-6 text-shell-muted"><%= prompt %></p><button type="button" data-action="progress#copy" data-prompt="<%= prompt %>" class="mt-4 rounded-full border border-shell-border bg-shell-card px-4 py-2 text-sm font-semibold text-shell-text"><%= t("home.copy") %></button><div class="mt-4 flex flex-col gap-2 text-sm sm:flex-row sm:gap-4"><a href="<%= locale_context.lesson_path("welcome") %>" class="font-medium text-shell-accent"><%= t("home.already_using") %></a><a href="https://github.com/Gentleman-Programming/gentle-shell#readme" class="font-medium text-shell-muted"><%= t("home.install") %></a></div></div>
  <div class="mt-5 rounded-2xl border border-shell-border bg-shell-card p-5 sm:p-7"><div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div><p class="font-mono text-xs text-shell-accent"><%= t("home.course") %></p><p class="mt-1 text-sm text-shell-muted"><%= t("home.keep_place") %></p></div><button type="button" data-action="progress#enroll" data-progress-target="enrollButton" class="shrink-0 rounded-full bg-shell-accent px-5 py-2.5 text-sm font-semibold text-white"><%= t("home.enroll") %></button></div><div data-progress-target="student" hidden class="mt-5 border-t border-shell-border pt-5"><p class="text-sm text-shell-muted"><%= t("home.student_id") %> <span data-progress-target="studentId" class="font-mono font-semibold text-shell-text"></span></p><p data-progress-target="summary" class="mt-2 text-sm font-medium text-shell-text"></p><p data-progress-target="continue" class="mt-2 text-sm text-shell-muted" hidden><a class="font-medium text-shell-accent"></a></p><p class="mt-3 break-words text-sm leading-6 text-shell-muted"><%= t("home.give_id") %> <a data-progress-target="instructionsUrl" class="font-mono text-shell-accent"></a></p><button type="button" data-action="progress#forget" data-progress-target="forgetButton" class="mt-4 text-sm font-medium text-shell-muted underline"><%= t("home.forget") %></button></div></div>
  <div class="mt-14 flex items-baseline justify-between gap-5"><h2 class="text-2xl font-bold"><%= t("home.syllabus") %></h2><p data-lesson-count class="font-mono text-xs text-shell-dim"><%= t("home.lesson_count", count: lesson_groups.values.sum(&:size)) %></p></div>
  <% lesson_groups.each do |module_name, lessons| %><section class="mt-6 overflow-hidden rounded-2xl border border-shell-border bg-shell-card"><div class="flex items-center justify-between gap-4 border-b border-shell-border px-5 py-4 sm:px-6"><h3 data-module-name="<%= module_name %>" class="text-base font-semibold text-shell-text"><%= module_name %></h3><span hidden data-module-name="<%= module_name %>" data-module-total="<%= lessons.size %>" data-progress-module-count class="shrink-0 font-mono text-xs text-shell-muted"><%= t("home.module_zero", count: lessons.size) %></span></div><ol class="divide-y divide-shell-border"><% lessons.each do |lesson| %><li data-progress-target="lesson" data-lesson-slug="<%= lesson.slug %>" data-module-name="<%= module_name %>" class="group flex gap-4 px-5 py-4 sm:px-6"><span class="w-6 pt-0.5 font-mono text-xs text-shell-dim"><%= format("%02d", lesson.order) %></span><div class="min-w-0 flex-1"><a href="<%= locale_context.lesson_path(lesson.slug) %>" data-lesson class="font-medium text-shell-text"><%= lesson.title %></a><p class="mt-1 text-sm leading-6 text-shell-muted"><%= lesson.description %></p></div><span data-progress-target="completion" data-lesson-slug="<%= lesson.slug %>" hidden aria-label="<%= t("home.completed") %>" class="pt-0.5 text-shell-accent">✓</span></li><% end %></ol></section><% end %>
</section>
