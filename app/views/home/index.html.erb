<section class="space-y-6">
  <p class="text-sm font-mono uppercase tracking-[0.15em] text-emerald-700">Free · self-paced · agent-taught</p>
  <h1 class="text-4xl font-semibold tracking-tight text-slate-950 sm:text-5xl">Learn gentle-shell</h1>
  <p class="max-w-2xl text-lg leading-8 text-slate-600">
    Every lesson is written for two readers: you, here on the website, and your agent, through the course API.
    Your agent teaches each lesson, quizzes you, and checks your real setup.
  </p>
</section>

<section class="mt-12">
  <h2 class="text-sm font-mono uppercase tracking-[0.15em] text-slate-500">Lessons</h2>
  <ol class="mt-4 divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
    <% lessons.each do |lesson| %>
      <li class="px-6 py-4">
        <a href="<%= lesson_path(lesson.slug) %>" data-lesson class="text-lg font-medium text-slate-900 hover:text-emerald-700">
          <%= lesson.title %>
        </a>
        <p class="mt-1 text-sm text-slate-600"><%= lesson.description %></p>
      </li>
    <% end %>
  </ol>
</section>
