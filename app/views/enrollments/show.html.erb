<% content_for :title, t("enrollment.title") %>
<div data-controller="enrollment">
<%= render layout: "shared/status_panel", locals: { eyebrow: t("enrollment.label"), heading: t("enrollment.title"), body: t("enrollment.body"), accent: true } do %>
  <div data-enrollment-target="switchWarning" hidden role="alert" class="mt-6 flex items-start gap-3 rounded-xl bg-brand-950/70 p-4 text-sm leading-6 text-fg-muted ring-1 ring-brand-500/35">
    <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 size-5 shrink-0 text-brand-300"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.72-1.36 3.486 0l6.717 11.941c.75 1.334-.214 2.96-1.742 2.96H3.282c-1.528 0-2.492-1.626-1.742-2.96L8.257 3.1ZM10 7.25a.75.75 0 0 0-.75.75v3.5a.75.75 0 0 0 1.5 0V8a.75.75 0 0 0-.75-.75Zm0 7.25a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" /></svg>
    <p><%= t("enrollment.warning") %></p>
  </div>
  <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
    <%= button_to t("enrollment.enroll"), locale_context.enroll_path(enrollment.code), method: :post, form: { data: { turbo: false } }, authenticity_token: true, form_class: "contents", class: "btn btn-primary" %>
    <%= link_to t("enrollment.not_now"), locale_context.root_path, class: "btn btn-secondary" %>
  </div>
<% end %>
</div>
