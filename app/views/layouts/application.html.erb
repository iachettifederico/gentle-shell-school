<!DOCTYPE html>
<html lang="<%= locale_context.locale %>">
  <head>
    <title><%= content_for(:title) || t("site.title") %></title>
    <meta name="description" content="<%= content_for(:description) || t("site.description") %>">
    <meta property="og:title" content="<%= content_for(:og_title) || content_for(:title) || t("site.title") %>">
    <meta property="og:description" content="<%= content_for(:og_description) || content_for(:description) || t("site.description") %>">
    <% locale_context.alternates.each do |locale, path| %>
      <link rel="alternate" hreflang="<%= locale %>" href="<%= path %>">
    <% end %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= csrf_meta_tags %><%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": Rails.env.production? ? "reload" : "" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-shell-bg font-sans text-shell-text antialiased">
    <header class="border-b border-shell-border bg-shell-bg/90 backdrop-blur">
      <nav class="mx-auto flex w-full max-w-6xl items-center justify-between gap-5 px-5 py-4 sm:px-8">
        <a href="<%= locale_context.root_path %>" class="text-base font-bold tracking-[-0.04em] text-shell-text">Gentle <span class="text-shell-accent">Shell</span></a>
        <div class="flex items-center gap-4 text-sm text-shell-muted sm:gap-6">
          <a href="<%= locale_context.root_path %>#lessons"><%= t("site.nav_lessons") %></a><a href="/llms.txt">llms.txt</a>
          <nav aria-label="<%= t("site.language") %>"><% locale_context.switcher_entries.each do |entry| %><a href="<%= entry[:path] %>" lang="<%= entry[:locale] %>" aria-current="<%= "page" if entry[:current] %>"><%= entry[:label] %></a><% end %></nav>
        </div>
      </nav>
    </header>
    <main class="mx-auto w-full max-w-6xl px-5 py-12 sm:px-8 sm:py-16"><%= yield %></main>
    <footer class="border-t border-shell-border"><div class="mx-auto flex max-w-6xl justify-between px-5 py-8 text-sm text-shell-dim"><p><%= t("site.footer") %></p><a href="https://github.com/<%= Rails.configuration.x.course.feedback_repository %>/issues/new?template=course-feedback.yml&lesson=site"><%= t("site.report_problem") %></a></div></footer>
  </body>
</html>
