<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Gentle Shell School" %></title>
    <meta name="description" content="<%= content_for(:description) || "A free, self-paced shell course taught with your coding agent." %>">
    <meta property="og:title" content="<%= content_for(:og_title) || content_for(:title) || "Gentle Shell School" %>">
    <meta property="og:description" content="<%= content_for(:og_description) || content_for(:description) || "A free, self-paced shell course taught with your coding agent." %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Gentle Shell School">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% app_stylesheets_paths.each do |stylesheet| %>
      <%= stylesheet_link_tag stylesheet, "data-turbo-track": Rails.env.production? ? "reload" : "" %>
    <% end %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-shell-bg font-sans text-shell-text antialiased">
    <header class="border-b border-shell-border bg-shell-bg/90 backdrop-blur">
      <nav class="mx-auto flex w-full max-w-6xl items-center justify-between gap-5 px-5 py-4 sm:px-8">
        <a href="<%= root_path %>" class="text-base font-bold tracking-[-0.04em] text-shell-text">Gentle <span class="text-shell-accent">Shell</span></a>
        <div class="flex items-center gap-4 text-sm text-shell-muted sm:gap-6">
          <a href="<%= root_path %>#lessons" class="transition-colors hover:text-shell-text">Lessons</a>
          <a href="/llms.txt" class="font-mono text-xs transition-colors hover:text-shell-text">llms.txt</a>
          <a href="/api/openapi.json" class="hidden font-mono text-xs transition-colors hover:text-shell-text sm:inline">API</a>
        </div>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
      <%= yield %>
    </main>

    <footer class="border-t border-shell-border">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-8 text-sm text-shell-dim sm:flex-row sm:items-center sm:justify-between sm:px-8">
        <p>Gentle Shell School — learn gentle-shell with your agent.</p>
        <a href="/llms.txt" class="font-mono text-xs transition-colors hover:text-shell-muted">Built for people and agents</a>
      </div>
    </footer>
  </body>
</html>
