<!DOCTYPE html>
<html lang="<%= locale_context.locale %>">
  <head>
    <title><%= content_for(:title) || t("site.title") %></title>
    <meta name="description" content="<%= content_for(:description) || t("site.description") %>">
    <meta property="og:title" content="<%= content_for(:og_title) || content_for(:title) || t("site.title") %>">
    <meta property="og:description" content="<%= content_for(:og_description) || content_for(:description) || t("site.description") %>">
    <% locale_context.alternates.each do |locale, path| %>
      <link rel="alternate" hreflang="<%= locale %>" href="<%= path %>">
    <% end %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0f0b0f">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= csrf_meta_tags %><%= csp_meta_tag %>
    <% app_stylesheets_paths.each do |stylesheet| %>
      <%= stylesheet_link_tag stylesheet, "data-turbo-track": Rails.env.production? ? "reload" : "" %>
    <% end %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="flex min-h-dvh flex-col bg-canvas font-sans text-fg antialiased">
    <a href="#main" class="skip-link"><%= t("site.skip") %></a>
    <header class="sticky top-0 z-40 border-b border-line bg-canvas/95 backdrop-blur-md">
      <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-x-3 gap-y-1 px-5 py-3 sm:gap-x-6 sm:px-8">
        <a href="<%= locale_context.root_path %>" class="order-1 flex items-center gap-2.5 rounded-lg font-mono text-sm font-semibold tracking-[-0.03em] text-brand-400">
          <span aria-hidden="true" class="grid size-8 place-items-center rounded-lg bg-brand-950 text-sm ring-1 ring-brand-500/30">&gt;_</span>
          <span>Gentle Shell <span class="text-fg-muted max-sm:sr-only">School</span></span>
        </a>
        <nav aria-label="<%= t("site.main_navigation") %>" class="order-3 -ml-3 w-full sm:order-2 sm:ml-auto sm:w-auto">
          <ul class="flex items-center gap-1 text-sm font-medium">
            <li><a href="<%= locale_context.root_path %>#lessons" class="rounded-full px-3 py-2 text-fg-muted transition-colors hover:bg-raised hover:text-fg"><%= t("site.nav_lessons") %></a></li>
            <li><a href="<%= locale_context.llms_path %>" class="rounded-full px-3 py-2 font-mono text-fg-muted transition-colors hover:bg-raised hover:text-fg">llms.txt</a></li>
          </ul>
        </nav>
        <nav aria-label="<%= t("site.language") %>" class="order-2 sm:order-3">
          <ul class="flex items-center gap-0.5 rounded-full bg-surface p-1 text-xs font-semibold ring-1 ring-line">
            <% locale_context.switcher_entries.each do |entry| %>
              <li>
                <a href="<%= entry[:path] %>" lang="<%= entry[:locale] %>" hreflang="<%= entry[:locale] %>" aria-current="<%= entry[:current] ? "page" : "false" %>" class="block rounded-full px-2 py-1.5 transition-colors sm:px-3 <%= entry[:current] ? "bg-brand-500 text-canvas" : "text-fg-muted hover:bg-raised hover:text-fg" %>">
                  <span class="lg:hidden"><%= entry[:locale].upcase %></span>
                  <span class="max-lg:sr-only"><%= entry[:label] %></span>
                </a>
              </li>
            <% end %>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1" class="mx-auto w-full max-w-6xl flex-1 px-5 py-12 outline-none sm:px-8 sm:py-16"><%= yield %></main>
    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-8 text-sm text-fg-muted sm:flex-row sm:items-center sm:justify-between sm:px-8">
        <p><%= t("site.footer") %></p>
        <a href="https://github.com/<%= Rails.configuration.x.course.feedback_repository %>/issues/new?template=course-feedback.yml&lesson=site" class="link self-start sm:self-auto"><%= t("site.report_problem") %></a>
      </div>
    </footer>
  </body>
</html>
