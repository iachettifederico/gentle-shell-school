<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Gentle Shell School" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Gentle Shell School">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag :app, "data-turbo-track": Rails.env.production? ? "reload" : "" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-stone-50 text-slate-900 antialiased">
    <header class="border-b border-slate-200 bg-white/80">
      <nav class="mx-auto flex w-full max-w-3xl items-center justify-between px-6 py-4">
        <a href="<%= root_path %>" class="font-semibold tracking-tight text-slate-950">Gentle Shell School</a>
        <a href="/llms.txt" class="text-sm font-mono text-slate-500 hover:text-slate-900">llms.txt</a>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-3xl px-6 py-12">
      <%= yield %>
    </main>
  </body>
</html>
